/assets/*
  Cache-Control: public, max-age=31536000, immutable

# public/assets/images/* is copied without a content hash, so it must stay revalidated
/assets/images/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/data/:patch/*
  Cache-Control: public, max-age=31536000, immutable
