{
	"name": "heimerbuild",
	"private": true,
	"version": "0.0.0",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun --bun vite",
		"build": "tsc && bun --bun vite build",
		"preview:local": "bun --bun vite preview",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test --pass-with-no-tests",
		"e2e": "playwright test",
		"check": "biome check",
		"check:write": "biome check --write",
		"deploy": "bun run build && wrangler deploy",
		"preview": "bun run build && wrangler preview",
		"sync-data": "bun scripts/sync-data/index.ts",
		"prepare": "[ -n \"$CI\" ] || lefthook install"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@sentry/react": "^11.1.0",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router": "^1.170.40",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"lucide-react": "^1.48.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "^8.0.6",
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@sentry/vite-plugin": "^5.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"lefthook": "2.1.14",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"wrangler": "4.142.0"
	}
}
