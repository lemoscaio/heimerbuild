{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!public/data"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"attributes": ["className"],
						"functions": ["cn", "clsx", "cva"]
					}
				}
			},
			"style": {
				"noDefaultExport": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true
					}
				}
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error"
			}
		}
	},
	"plugins": [
		{
			"path": "./biome-plugins/motion-imports.grit",
			"includes": [
				"**/src/**",
				"!**/src/components/motion/**",
				"!**/src/**/*.motion.tsx",
				"!**/src/app/motion-provider.tsx",
				"!**/src/app/motion-features.ts"
			]
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["vite.config.ts", "playwright.config.ts", "worker/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/components/**",
				"src/data/**",
				"src/hooks/**",
				"src/lib/**",
				"src/types/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features",
											"@/features/**",
											"@/pages",
											"@/pages/**",
											"@/routes",
											"@/routes/**",
											"**/features/**",
											"**/pages/**",
											"**/routes/**"
										],
										"message": "Shared layers never import from features/, pages/ or routes/ (docs/frontend-architecture.md#import-boundaries)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/pages/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/routes", "@/routes/**", "**/routes/**"],
										"message": "A page never imports a route: routes import pages (docs/frontend-architecture.md#import-boundaries)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features",
											"@/features/**",
											"../../**",
											"!../../../../scripts/**"
										],
										"message": "A feature imports its own files relatively (../lib/x) and never another feature: move shared code to components/common, hooks, lib, types or data (docs/frontend-architecture.md#import-boundaries)."
									},
									{
										"group": [
											"@/pages",
											"@/pages/**",
											"**/pages/**",
											"@/routes",
											"@/routes/**",
											"**/routes/**"
										],
										"message": "A feature never imports a page or a route: pages compose features, never the other way (docs/frontend-architecture.md#import-boundaries)."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
