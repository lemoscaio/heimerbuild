{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!public/data"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noAutofocus": "warn",
				"noStaticElementInteractions": "warn",
				"useAltText": "warn",
				"useButtonType": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useJsxKeyInIterable": "warn"
			},
			"suspicious": {
				"noImplicitAnyLet": "warn",
				"useIterableCallbackReturn": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
