# Copy to .env.local (gitignored) to enable telemetry locally. Deploys get the keys from the
# Cloudflare Workers Builds build variables; builds without them (forks, CI) send nothing.

# PostHog project key (public, phc_...). Without it PostHog never starts.
VITE_POSTHOG_KEY=
# Sentry DSN of heimerbuild-web (public). Without it Sentry never starts.
VITE_SENTRY_DSN=

# Local builds and the dev server stay silent unless these are "true" (they need the key above).
# Local events go straight to PostHog/Sentry (no Worker proxy) tagged environment=development.
VITE_POSTHOG_ENABLED=
VITE_SENTRY_ENABLED=
